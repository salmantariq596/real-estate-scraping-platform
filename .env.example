# ============================================================
# PINCALI ETL PLATFORM — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ─── Database ───────────────────────────────────────────────
# Choose: postgresql | mysql
DATABASE_TYPE=postgresql

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pincali
POSTGRES_USER=pincali
POSTGRES_PASSWORD=changeme

# MySQL (used when DATABASE_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=pincali
MYSQL_USER=pincali
MYSQL_PASSWORD=changeme

# Full override (takes precedence over individual vars)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
SECRET_KEY=change-this-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Scraper ────────────────────────────────────────────────
PINCALI_CONCURRENCY=5
PINCALI_HEADLESS=true
PINCALI_TIMEOUT=50000
PINCALI_MAX_RETRIES_PER_URL=2
PINCALI_BROWSER_RESTART_EVERY=100
PINCALI_RATE_LIMIT_MIN=1.0
PINCALI_RATE_LIMIT_MAX=3.0
PINCALI_HTTP_FIRST=true
PINCALI_BLOCK_ASSETS=true
PINCALI_BROWSER_MAX_MEMORY_MB=500
PINCALI_ENABLE_KEYWORD_LEARNING=true
PINCALI_KEYWORD_SAVE_EVERY=100
PINCALI_HUB_SOURCE_NAME=pincali

# ─── Proxy ──────────────────────────────────────────────────
# Comma-separated proxy URLs (leave empty for no proxy)
# Example: http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PINCALI_PROXY_LIST=

# ─── Proxy Provider (rotating residential proxy support) ─────
# static  = comma-separated PINCALI_PROXY_LIST above (default, zero risk)
# gateway = single rotating-residential gateway vendor - fill in the
#           PROXY_GATEWAY_* block below once Oscar confirms the vendor
# file    = pool loaded from a local file, see PROXY_FILE_PATH
PROXY_PROVIDER=static

# How many requests one proxy/session handles before auto-rotating to a
# fresh session (gateway provider only). 1 = new IP on every request.
PROXY_ROTATE_EVERY_N_REQUESTS=1

# Consecutive failures before a proxy endpoint is put in cooldown/skipped.
PROXY_FAILURE_THRESHOLD=3

# How long (seconds) a failed proxy stays in cooldown before retry.
PROXY_COOLDOWN_SECONDS=120

# Max concurrent in-flight requests per proxy/session (respects vendor
# concurrent-connection limits).
PROXY_MAX_CONCURRENT_PER_SESSION=5

# Global requests/sec ceiling across the whole proxy pool. 0 = unlimited.
PROXY_GLOBAL_RPS_LIMIT=0

# In-request retry loop for blocked/failed fetches (proxy-level failures
# only - genuine 404s / removed listings are not retried).
PROXY_MAX_RETRIES_PER_REQUEST=3
PROXY_RETRY_BACKOFF_BASE_SECONDS=1.0

# ─── Gateway provider (used when PROXY_PROVIDER=gateway) ─────
# Fill in once Oscar confirms the vendor (Bright Data / Oxylabs /
# Smartproxy / IPRoyal / other). Username templating defaults to the
# common "{user}-session-{session_id}" pattern; override
# PROXY_GATEWAY_USER_TEMPLATE if the vendor uses a different format.
PROXY_GATEWAY_HOST=
PROXY_GATEWAY_PORT=
PROXY_GATEWAY_USER=
PROXY_GATEWAY_PASS=
PROXY_GATEWAY_USER_TEMPLATE={user}-session-{session_id}
PROXY_GATEWAY_POOL_SIZE=10

# ─── File-backed provider (used when PROXY_PROVIDER=file) ────
# One proxy URL per line, '#' comments allowed.
PROXY_FILE_PATH=

# ─── Exchange Rate ──────────────────────────────────────────
MXN_TO_USD_RATE=20.5
# Set to "live" to fetch from open exchange rates (requires EXCHANGE_API_KEY)
EXCHANGE_RATE_MODE=static
EXCHANGE_API_KEY=

# ─── URL Discovery Worker ───────────────────────────────────
DISCOVERY_INTERVAL_SECONDS=3600
DISCOVERY_SORT_METHODS=newest,oldest,expensive,cheapest
DISCOVERY_MAX_PAGES_PER_FILTER=101

# ─── Detail Scraper Worker ──────────────────────────────────
SCRAPER_BATCH_SIZE=50
SCRAPER_POLL_INTERVAL=10

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ─── Metrics (optional) ─────────────────────────────────────
PROMETHEUS_PORT=9090
